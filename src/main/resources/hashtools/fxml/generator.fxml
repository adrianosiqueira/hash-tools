<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" fx:controller="hashtools.controller.GeneratorController" fx:id="pnlRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <GridPane alignment="CENTER" hgap="20" styleClass="island-pane" vgap="20">
        <padding>
            <Insets topRightBottomLeft="20"/>
        </padding>

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
            <ColumnConstraints halignment="CENTER" hgrow="NEVER"/>
            <ColumnConstraints halignment="CENTER" hgrow="NEVER"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints valignment="CENTER" vgrow="NEVER"/>
            <RowConstraints valignment="TOP" vgrow="NEVER"/>
            <RowConstraints valignment="CENTER" vgrow="NEVER"/>
        </rowConstraints>



        <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Input"/>
        <TextField GridPane.columnIndex="1" GridPane.rowIndex="0" fx:id="txtInput" maxWidth="1E6"/>
        <CheckBox GridPane.columnIndex="2" GridPane.rowIndex="0" fx:id="chkInput" selected="true" text="File"/>
        <Button GridPane.columnIndex="3" GridPane.rowIndex="0" onAction="#openInputFile" text="Open"/>



        <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Algorithms"/>
        <GridPane GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" alignment="TOP_CENTER" fx:id="pnlAlgorithm" hgap="20" vgap="20">

            <columnConstraints>
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints valignment="CENTER" vgrow="NEVER"/>
                <RowConstraints valignment="CENTER" vgrow="NEVER"/>
                <RowConstraints valignment="CENTER" vgrow="NEVER"/>
            </rowConstraints>



            <CheckBox GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="1E6" selected="true" text="MD5"/>
            <CheckBox GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1E6" selected="true" text="SHA-1"/>
            <CheckBox GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="1E6" selected="true" text="SHA-224"/>



            <CheckBox GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="1E6" selected="true" text="SHA-256"/>
            <CheckBox GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1E6" selected="true" text="SHA-384"/>
            <CheckBox GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="1E6" selected="true" text="SHA-512"/>



            <HBox GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2">
                <Hyperlink HBox.hgrow="NEVER" onAction="#selectAllAlgorithms" text="Select all"/>
                <Label HBox.hgrow="ALWAYS" maxWidth="1E6"/>
                <Hyperlink HBox.hgrow="NEVER" onAction="#selectNoAlgorithms" text="Select none"/>
                <Label HBox.hgrow="ALWAYS" maxWidth="1E6"/>
                <Hyperlink HBox.hgrow="NEVER" onAction="#invertAlgorithmsSelection" text="Invert selection"/>
            </HBox>
        </GridPane>



        <Button GridPane.columnIndex="0" GridPane.rowIndex="2" onAction="#performChecksumGeneration" text="Execute"/>
        <ProgressBar GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" fx:id="prgProgress" maxWidth="1E6" progress="0.0"/>
    </GridPane>
</VBox>
