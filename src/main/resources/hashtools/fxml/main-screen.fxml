<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<HBox fx:controller="hashtools.module.main.controller.MainController" fx:id="pnlRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <VBox HBox.hgrow="NEVER" fx:id="pnlButtons">
        <Button VBox.vgrow="ALWAYS" fx:id="btnChecking" maxHeight="1E6" maxWidth="1E6" onAction="#openCheckingScreen" text="Check"/>
        <Button VBox.vgrow="ALWAYS" fx:id="btnGeneration" maxHeight="1E6" maxWidth="1E6" onAction="#openGenerationScreen" text="Generate"/>
        <Button VBox.vgrow="ALWAYS" fx:id="btnComparison" maxHeight="1E6" maxWidth="1E6" onAction="#openComparisonScreen" text="Compare"/>
    </VBox>

    <StackPane HBox.hgrow="ALWAYS" fx:id="pnlContent">
        <padding>
            <Insets topRightBottomLeft="20"/>
        </padding>
    </StackPane>
</HBox>
