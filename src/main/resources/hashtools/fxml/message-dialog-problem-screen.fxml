<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<GridPane alignment="CENTER" hgap="20" vgap="40" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="-Infinity"/>
        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="0.0"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints valignment="TOP" vgrow="SOMETIMES"/>
        <RowConstraints valignment="TOP" vgrow="SOMETIMES"/>
        <RowConstraints valignment="TOP" vgrow="SOMETIMES"/>
    </rowConstraints>



    <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Description"/>
    <Label GridPane.columnIndex="1" GridPane.rowIndex="0" fx:id="lblDescription" maxWidth="1E6" textAlignment="JUSTIFY" wrapText="true"/>



    <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Cause"/>
    <Label GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="lblCause" maxWidth="1E6" textAlignment="JUSTIFY" wrapText="true"/>



    <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Fix"/>
    <Label GridPane.columnIndex="1" GridPane.rowIndex="2" fx:id="lblFix" maxWidth="1E6" textAlignment="JUSTIFY" wrapText="true"/>
</GridPane>
